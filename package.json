{
  "name": "@decodo/ai-sdk",
  "version": "0.0.0-semantic-release",
  "description": "Decodo Web Data API tools for the Vercel AI SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Decodo/ai-sdk.git"
  },
  "homepage": "https://github.com/Decodo/ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/Decodo/ai-sdk/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "decodo",
    "web-scraping",
    "tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./build/cjs/index.cjs",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.cts",
        "default": "./build/cjs/index.cjs"
      }
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "rm -rf build/cjs && mkdir -p build/cjs && esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=build/cjs/index.cjs && dts-bundle-generator -o build/cjs/index.d.cts --project tsconfig.build.json build/esm/index.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build:esm && pnpm run build:cjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@decodo/sdk-ts": "^3.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.7.0",
    "ai": "^7.0.163",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.33.3"
}
